// Prisma schema for job-huntrx. Each `model` maps to one Postgres table.
// The connection URL is configured in ../prisma.config.ts, not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Our tsconfig uses NodeNext resolution, which requires .js extensions on relative imports.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Bare users table (TASK-003). Profile fields arrive in TASK-010.
model User {
  // Generated by Postgres (built in since PG13), so raw-SQL inserts get an id too.
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // DB default covers non-Prisma inserts; on update, the Prisma client bumps it
  // (not a DB trigger, so raw-SQL updates must set it themselves).
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}
